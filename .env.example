# Copy to .env; systemd reads it. For manual runs: set -a; . ./.env; set +a
# Loopback is safest. Set 0.0.0.0 only on a trusted/firewalled LAN.
BIND_HOST=127.0.0.1
PORT=8765
CHROMIUM_PATH=/usr/bin/chromium
CODEX_POLL_SECONDS=5
CLAUDE_REFRESH_SECONDS=5
PROVIDER_FALLBACK_SECONDS=300
DISCOVER=0
LOG_LEVEL=INFO
# Optional: PYTHON_BIN=/absolute/path/to/venv/bin/python
# Optional: CODEX_USAGE_URL=https://chatgpt.com/codex/settings/usage
# Optional: CLAUDE_USAGE_URL=https://claude.ai/settings/usage
# run-xvfb.sh intentionally enforces HEADLESS=0 for its virtual display.
